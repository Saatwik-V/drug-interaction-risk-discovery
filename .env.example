# ==============================================================================
# Environment Configuration Template
# Patient-Specific Multi-Hop Drug Interaction Risk Discovery
#
# INSTRUCTIONS:
# Copy this file to .env or .env.local for local development.
# Never commit actual credentials or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Relational Database)
# ------------------------------------------------------------------------------
# Connection string for PostgreSQL database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/drug_interaction_db"

# Discrete connection parameters (optional, if preferred by specific connection poolers)
PGHOST="localhost"
PGPORT="5432"
PGDATABASE="drug_interaction_db"
PGUSER="USER"
PGPASSWORD="PASSWORD"

# ------------------------------------------------------------------------------
# Neo4j Configuration (Graph Database)
# ------------------------------------------------------------------------------
# Bolt URI for local Neo4j instance
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="YOUR_NEO4J_PASSWORD"

# ------------------------------------------------------------------------------
# Authentication & Application Secrets
# ------------------------------------------------------------------------------
# Secret key used for session signing and JWT encryption (e.g. openssl rand -base64 32)
AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_KEY"

# Base URL for NextAuth / application routing
NEXTAUTH_URL="http://localhost:3000"

# Application server port
PORT=3000
