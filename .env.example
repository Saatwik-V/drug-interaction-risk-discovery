# ==============================================================================
# Environment Configuration Template
# Patient-Specific Multi-Hop Drug Interaction Risk Discovery
#
# INSTRUCTIONS:
# Copy this file to .env or .env.local for local development.
# Never commit actual credentials or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Relational Database)
# ------------------------------------------------------------------------------
# Default application connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/drug_interaction_db"

# Discrete connection parameters
PGHOST="localhost"
PGPORT="5432"
PGDATABASE="drug_interaction_db"
PGUSER="postgres"
PGPASSWORD="postgres"

# Dedicated Least-Privilege Database Roles (DBMS Rubric Requirement)
# Doctor connection (restricted: cannot access user_accounts, cannot delete patients)
DOCTOR_DATABASE_URL="postgresql://app_doctor_user:DoctorPass%232026@localhost:5432/drug_interaction_db"
# Administrator connection (full clinical & account administration)
ADMIN_DATABASE_URL="postgresql://app_admin_user:AdminPass%232026@localhost:5432/drug_interaction_db"

# ------------------------------------------------------------------------------
# Neo4j Configuration (Graph Database)
# ------------------------------------------------------------------------------
# Bolt URI for local Neo4j instance
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password123"
NEO4J_AUTH="neo4j/password123"

# ------------------------------------------------------------------------------
# Authentication & Application Secrets
# ------------------------------------------------------------------------------
# Secret key used for session signing and JWT encryption (min 32 characters)
AUTH_SECRET="your_32_character_random_secret_key_here"
JWT_SECRET="your_32_character_random_secret_key_here"

# Base URL for NextAuth / application routing
NEXTAUTH_URL="http://localhost:3000"

# Application server port
PORT=3000
