r&gt;UNIQUE(pair_id, mechanism_category, source_dataset)" style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2320" y="680" width="260" height="60" as="geometry" /></mxCell><mxCell id="note_patient" value="&lt;b&gt;Patient safeguards&lt;/b&gt;&lt;br&gt;UNIQUE(mrn); gender ∈ {Male, Female, Other}; is_synthetic = TRUE." style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="170" y="1000" width="330" height="65" as="geometry" /></mxCell><mxCell id="note_rx" value="&lt;b&gt;Prescription constraints&lt;/b&gt;&lt;br&gt;UNIQUE(patient_id, drug_id, start_date); status ∈ {ACTIVE, DISCONTINUED, COMPLETED}; end_date ≥ start_date when present." style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="1000" width="390" height="90" as="geometry" /></mxCell><mxCell id="note_ra" value="&lt;b&gt;Assessment constraints&lt;/b&gt;&lt;br&gt;max_hop_depth ∈ {1,2,3}; count fields default to 0 and are maintained by trigger on insert." style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="1430" width="370" height="75" as="geometry" /></mxCell><mxCell id="note_finding" value="&lt;b&gt;Finding constraints&lt;/b&gt;&lt;br&gt;hop_count ∈ {1,2,3}; finding_type ∈ {DOCUMENTED_DIRECT, CANDIDATE_PATHWAY}.&lt;br&gt;Severity/mechanism are point-in-time snapshots." style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1510" y="1430" width="430" height="90" as="geometry" /></mxCell><mxCell id="note_user" value="&lt;b&gt;Conceptual relationship&lt;/b&gt;&lt;br&gt;PERFORMED_BY reflects authenticated session identity. Current SQL stores performed_by as text, not a user_id FK." style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2040" y="1470" width="490" height="80" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Rectangle = entity&lt;br&gt;Oval = attribute; underlined = primary key&lt;br&gt;Diamond = relationship&lt;br&gt;(min,max) = participation/cardinality&lt;br&gt;Dashed connector = conceptual relationship not enforced by SQL FK" style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1400" width="340" height="150" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>