<mxfile host="app.diagrams.net" modified="2026-10-20T05:20:00.000Z" agent="ChatGPT" version="24.7.17" type="device"><diagram id="relational-schema---final" name="Relational Schema - Final"><mxGraphModel dx="2600" dy="1700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;DRUG INTERACTION RISK DISCOVERY — RELATIONAL SCHEMA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;PostgreSQL tables • PK underlined • FK arrows show references • constraints summarized below&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="15" width="1200" height="55" as="geometry" /></mxCell><mxCell id="t_drugs" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b&gt;DRUGS&lt;/b&gt;&lt;br&gt;&lt;u&gt;&lt;b&gt;PK drug_id&lt;/b&gt;&lt;/u&gt; : SERIAL&lt;br&gt;canonical_name : VARCHAR(255) NOT NULL UNIQUE&lt;br&gt;pubchem_cid : VARCHAR(50)&lt;br&gt;inchikey : VARCHAR(50)&lt;br&gt;smiles : TEXT&lt;br&gt;drug_type : VARCHAR(100)&lt;br&gt;therapeutic_class : TEXT&lt;br&gt;created_at : TIMESTAMPTZ NOT NULL&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="420" height="300" as="geometry" /></mxCell><mxCell id="t_drug_source_mappings" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b&gt;DRUG_SOURCE_MAPPINGS&lt;/b&gt;&lt;br&gt;&lt;u&gt;&lt;b&gt;PK mapping_id&lt;/b&gt;&lt;/u&gt; : SERIAL&lt;br&gt;&lt;b&gt;FK drug_id&lt;/b&gt; : INT → drugs.drug_id&lt;br&gt;source_name : VARCHAR(50) NOT NULL&lt;br&gt;source_drug_id : VARCHAR(50) NOT NULL&lt;br&gt;source_drug_name : VARCHAR(255) NOT NULL&lt;br&gt;match_method : VARCHAR(50) NOT NULL&lt;br&gt;created_at : TIMESTAMPTZ NOT NULL&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="440" height="280" as="geometry" /></mxCell><mxCell id="t_ddi_pairs" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b&gt;DDI_PAIRS&lt;/b&gt;&lt;br&gt;&lt;u&gt;&lt;b&gt;PK pair_id&lt;/b&gt;&lt;/u&gt; : BIGSERIAL&lt;br&gt;&lt;b&gt;FK drug_a_id&lt;/b&gt; : INT → drugs.drug_id&lt;br&gt;&lt;b&gt;FK drug_b_id&lt;/b&gt; : INT → drugs.drug_id&lt;br&gt;created_at : TIMESTAMPTZ NOT NULL&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1070" y="140" width="400" height="200" as="geometry" /></mxCell><mxCell id="t_ddi_severities" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b&gt;DDI_SEVERITIES&lt;/b&gt;&lt;br&gt;&lt;u&gt;&lt;b&gt;PK severity_id&lt;/b&gt;&lt;/u&gt; : BIGSERIAL&lt;br&gt;&lt;b&gt;FK pair_id&lt;/b&gt; : BIGINT → ddi_pairs.pair_id&lt;br&gt;severity_level : VARCHAR(20) NOT NULL&lt;br&gt;source_dataset : VARCHAR(50) NOT NULL DEFAULT DDInter&lt;br&gt;source_atc_codes : VARCHAR(100)&lt;br&gt;created_at : TIMESTAMPTZ NOT NULL&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1540" y="140" width="440" height="240" as="geometry" /></mxCell><mxCell id="t_ddi_mechanisms" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b&gt;DDI_MECHANISMS&lt;/b&gt;&lt;br&gt;&lt;u&gt;&lt;b&gt;PK mechanism_id&lt;/b&gt;&lt;/u&gt; : BIGSERIAL&lt;br&gt;&lt;b&gt;FK pair_id&lt;/b&gt; : BIGINT → ddi_pairs.pair_id&lt;br&gt;mechanism_category : VARCHAR(100) NOT NULL&lt;br&gt;source_dataset : VARCHAR(50) NOT NULL DEFAULT MecDDI&lt;br&gt;created_at : TIMESTAMPTZ NOT NULL&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2040" y="140" width="470" height="240" as="geometry" /></mxCell><mxCell id="t_patients" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b&gt;PATIENTS&lt;/b&gt;&lt;br&gt;&lt;u&gt;&lt;b&gt;PK patient_id&lt;/b&gt;&lt;/u&gt; : SERIAL&lt;br&gt;mrn : VARCHAR(50) NOT NULL UNIQUE&lt;br&gt;full_name : VARCHAR(255) NOT NULL&lt;br&gt;gender : VARCHAR(20) NOT NULL&lt;br&gt;date_of_birth : DATE NOT NULL&lt;br&gt;primary_condition : VARCHAR(255)&lt;br&gt;is_synthetic : BOOLEAN NOT NULL DEFAULT TRUE&lt;br&gt;created_at : TIMESTAMPTZ NOT NULL&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="570" width="420" height="280" as="geometry" /></mxCell><mxCell id="t_prescriptions" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b&gt;PRESCRIPTIONS&lt;/b&gt;&lt;br&gt;&lt;u&gt;&lt;b&gt;PK prescription_id&lt;/b&gt;&lt;/u&gt; : SERIAL&lt;br&gt;&lt;b&gt;FK patient_id&lt;/b&gt; : INT → patients.patient_id&lt;br&gt;&lt;b&gt;FK drug_id&lt;/b&gt; : INT → drugs.drug_id&lt;br&gt;dosage : VARCHAR(100) NOT NULL&lt;br&gt;frequency : VARCHAR(100) NOT NULL&lt;br&gt;status : VARCHAR(20) NOT NULL DEFAULT ACTIVE&lt;br&gt;prescribed_by : VARCHAR(100) NOT NULL&lt;br&gt;start_date : DATE NOT NULL&lt;br&gt;end_date : DATE NULL&lt;br&gt;created_at : TIMESTAMPTZ NOT NULL&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="570" width="440" height="340" as="geometry" /></mxCell><mxCell id="t_risk_assessments" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b&gt;RISK_ASSESSMENTS&lt;/b&gt;&lt;br&gt;&lt;u&gt;&lt;b&gt;PK assessment_id&lt;/b&gt;&lt;/u&gt; : BIGSERIAL&lt;br&gt;&lt;b&gt;FK patient_id&lt;/b&gt; : INT → patients.patient_id&lt;br&gt;performed_by : VARCHAR(100) NOT NULL (no FK)&lt;br&gt;max_hop_depth : INT NOT NULL DEFAULT 2&lt;br&gt;total_active_medications : INT NOT NULL&lt;br&gt;direct_interaction_count : INT NOT NULL DEFAULT 0&lt;br&gt;multi_hop_candidate_count : INT NOT NULL DEFAULT 0&lt;br&gt;assessment_notes : TEXT&lt;br&gt;created_at : TIMESTAMPTZ NOT NULL&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1070" y="570" width="440" height="340" as="geometry" /></mxCell><mxCell id="t_assessment_findings" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b&gt;ASSESSMENT_FINDINGS&lt;/b&gt;&lt;br&gt;&lt;u&gt;&lt;b&gt;PK finding_id&lt;/b&gt;&lt;/u&gt; : BIGSERIAL&lt;br&gt;&lt;b&gt;FK assessment_id&lt;/b&gt; : BIGINT → risk_assessments.assessment_id&lt;br&gt;&lt;b&gt;FK drug_a_id&lt;/b&gt; : INT → drugs.drug_id&lt;br&gt;&lt;b&gt;FK drug_b_id&lt;/b&gt; : INT → drugs.drug_id&lt;br&gt;hop_count : INT NOT NULL&lt;br&gt;traversal_path : TEXT NOT NULL&lt;br&gt;severity_level : VARCHAR(20) snapshot&lt;br&gt;mechanism_category : VARCHAR(100) snapshot&lt;br&gt;evidence_sources : VARCHAR(100) NOT NULL&lt;br&gt;finding_type : VARCHAR(50) NOT NULL&lt;br&gt;created_at : TIMESTAMPTZ NOT NULL&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1570" y="570" width="470" height="380" as="geometry" /></mxCell><mxCell id="t_user_accounts" value="&lt;div style=&quot;text-align:left;line-height:1.45&quot;&gt;&lt;b&gt;USER_ACCOUNTS&lt;/b&gt;&lt;br&gt;&lt;u&gt;&lt;b&gt;PK user_id&lt;/b&gt;&lt;/u&gt; : SERIAL&lt;br&gt;username : VARCHAR(100) NOT NULL UNIQUE&lt;br&gt;password_hash : VARCHAR(255) NOT NULL&lt;br&gt;full_name : VARCHAR(255) NOT NULL&lt;br&gt;role : VARCHAR(20) NOT NULL&lt;br&gt;is_active : BOOLEAN NOT NULL DEFAULT TRUE&lt;br&gt;created_at : TIMESTAMPTZ NOT NULL&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="2100" y="570" width="420" height="280" as="geometry" /></mxCell><mxCell id="fk_0" value="FK drug_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;strokeWidth=1.4;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="t_drug_source_mappings" target="t_drugs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fk_1" value="FK drug_a_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;strokeWidth=1.4;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="t_ddi_pairs" target="t_drugs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fk_2" value="FK drug_b_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;strokeWidth=1.4;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="t_ddi_pairs" target="t_drugs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fk_3" value="FK pair_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;strokeWidth=1.4;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="t_ddi_severities" target="t_ddi_pairs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fk_4" value="FK pair_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;strokeWidth=1.4;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="t_ddi_mechanisms" target="t_ddi_pairs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fk_5" value="FK patient_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;strokeWidth=1.4;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="t_prescriptions" target="t_patients"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fk_6" value="FK drug_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;strokeWidth=1.4;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="t_prescriptions" target="t_drugs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fk_7" value="FK patient_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;strokeWidth=1.4;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="t_risk_assessments" target="t_patients"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fk_8" value="FK assessment_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;strokeWidth=1.4;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="t_assessment_findings" target="t_risk_assessments"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fk_9" value="FK drug_a_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;strokeWidth=1.4;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="t_assessment_findings" target="t_drugs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="fk_10" value="FK drug_b_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;startArrow=none;strokeWidth=1.4;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="t_assessment_findings" target="t_drugs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="constraints1" value="&lt;b&gt;Key and integrity constraints&lt;/b&gt;&lt;br&gt;• drugs: UNIQUE(canonical_name)&lt;br&gt;• drug_source_mappings: UNIQUE(source_name, source_drug_id); source_name ∈ {DDInter, MecDDI}&lt;br&gt;• ddi_pairs: UNIQUE(drug_a_id, drug_b_id); CHECK drug_a_id &amp;lt; drug_b_id&lt;br&gt;• ddi_severities: UNIQUE(pair_id, source_dataset); severity ∈ {Major, Moderate, Minor, Unknown}&lt;br&gt;• ddi_mechanisms: UNIQUE(pair_id, mechanism_category, source_dataset)" style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="1030" width="760" height="250" as="geometry" /></mxCell><mxCell id="constraints2" value="&lt;b&gt;Patient and transaction constraints&lt;/b&gt;&lt;br&gt;• patients: UNIQUE(mrn); gender ∈ {Male, Female, Other}; is_synthetic = TRUE&lt;br&gt;• prescriptions: UNIQUE(patient_id, drug_id, start_date); status ∈ {ACTIVE, DISCONTINUED, COMPLETED}; end_date ≥ start_date if present&lt;br&gt;• risk_assessments: max_hop_depth BETWEEN 1 AND 3&lt;br&gt;• assessment_findings: hop_count BETWEEN 1 AND 3; finding_type ∈ {DOCUMENTED_DIRECT, CANDIDATE_PATHWAY}&lt;br&gt;• user_accounts: UNIQUE(username); role ∈ {ADMIN, DOCTOR}" style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="1030" width="760" height="250" as="geometry" /></mxCell><mxCell id="notes" value="&lt;b&gt;Implementation notes&lt;/b&gt;&lt;br&gt;• All tables have created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP.&lt;br&gt;• SERIAL/BIGSERIAL primary keys are generated by PostgreSQL.&lt;br&gt;• prescriptions.prescribed_by and risk_assessments.performed_by are text fields, not FKs to user_accounts.&lt;br&gt;• assessment_findings severity/mechanism fields are point-in-time snapshots.&lt;br&gt;• Source ATC codes are stored as provenance text in source_atc_codes.&lt;br&gt;• Counters in risk_assessments are trigger-maintained on finding insertion; RBAC intends append-only clinician access." style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1690" y="1030" width="850" height="270" as="geometry" /></mxCell><mxCell id="legend2" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;PK = Primary Key (underlined)&lt;br&gt;FK = Foreign Key (arrow points to referenced table)&lt;br&gt;Fields marked snapshot are intentionally stored at assessment time.&lt;br&gt;Only database-enforced FKs are shown as connectors." style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="1360" width="600" height="120" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>